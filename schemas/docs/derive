#!/usr/bin/env bash
# docs schema — the pack's default doc dialect.
#
# Schema contract (what every schema's `derive` must do):
#   stdin:  one candidate doc, whole file, frontmatter included
#   stdout: exactly one JSON verdict —
#     {"verdict":"skip"}                                  not this schema's doc
#     {"verdict":"refuse","document_id":…,"reason":…}     claims to be one, malformed
#     {"verdict":"ship","document_id":…,"strategy":…,
#      "tags":[…],"observation_scopes":[[…]],
#      "context":…,"timestamp":…}                         ready to retain
#       (optional "content" overrides the core's default of
#        frontmatter-stripped body)
#   stderr: warn-level findings (shipped anyway), one per line
#   env (provided by the core when available):
#     HINDSIGHT_KNOWN_REPOS         newline-separated rig names
#     HINDSIGHT_KNOWN_DOMAINS_FILE  known-domains file, one per line
#
# Type selects extraction strategy. Status is required for every document.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FILE="$(mktemp)"; trap 'rm -f "$FILE"' EXIT
cat > "$FILE"
head -1 "$FILE" | grep -q '^---[[:space:]]*$' || { echo '{"verdict":"skip"}'; exit 0; }
if ! awk 'NR>1 && /^---[[:space:]]*$/ {found=1; exit} END {exit !found}' "$FILE"; then
  echo '{"verdict":"refuse","document_id":"?","reason":"unterminated frontmatter"}'
  exit 0
fi
if ! frontmatter="$(yq --front-matter=extract -o=json '.' "$FILE" 2>/dev/null)"; then
  echo '{"verdict":"refuse","document_id":"?","reason":"malformed YAML frontmatter"}'
  exit 0
fi
python3 "$DIR/validate.py" <<<"$frontmatter"
